# Supabase — create a NEW project at https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Transactional email (Resend) — https://resend.com
RESEND_API_KEY=
EMAIL_FROM=Sales Pipeline <onboarding@resend.dev>
EMAIL_MONTHLY_LIMIT=3000

# Google OAuth (login via Supabase + future Gmail integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# OAuth state signing (API) — required, min 32 characters
OAUTH_STATE_SECRET=

# Encrypt integration tokens at rest (API) — base64-encoded 32-byte key
# Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Website form webhook (API)
LEAD_WEBHOOK_SECRET=

# Vercel Cron — secures /cron/keep-alive (min 32 characters)
# Generate: openssl rand -hex 32
CRON_SECRET=

# Termene.ro company verification (web server actions — keep secret)
TERMENE_API_URL=https://api.termene.ro/v2
TERMENE_USERNAME=
TERMENE_PASSWORD=
TERMENE_SCHEMA_KEY=
